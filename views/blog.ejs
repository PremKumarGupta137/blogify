<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
    <title><%= blog.title %> — Blogify</title>
  </head>
  <body>
    <%- include('partials/nav') %>

    <div class="container mt-4 fade-in" style="max-width: 760px;">
      <% if (locals.flash) { %>
        <div class="alert alert-success" role="alert"><%= flash %></div>
      <% } %>

      <% if (blog.status === 'draft') { %>
        <div class="alert alert-draft" role="alert">This post is a draft — only you can see it.</div>
      <% } %>

      <% if (blog.coverImageURL) { %>
        <img src="<%= blog.coverImageURL %>" class="blog-hero-cover" alt="<%= blog.title %>" />
      <% } %>

      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <h1 class="blog-title mb-0"><%= blog.title %></h1>
        <% if (locals.owner) { %>
          <div class="d-flex gap-2 blog-owner-actions">
            <a href="/blog/edit/<%= blog._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
            <button type="button" class="btn btn-sm btn-outline-danger" data-confirm-delete
              data-form-action="/blog/delete/<%= blog._id %>"
              data-confirm-text="Delete “<%= blog.title %>” permanently? This can't be undone.">
              Delete
            </button>
          </div>
        <% } %>
      </div>

      <p class="blog-meta">
        <%= new Date(blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
        &middot; <%= readingTime %> min read
        &middot; <%= blog.views %> view<%= blog.views === 1 ? '' : 's' %>
      </p>

      <% if (blog.tags && blog.tags.length) { %>
        <div class="tag-pills mb-3">
          <% blog.tags.forEach(tag => { %>
            <a href="/?tag=<%= encodeURIComponent(tag) %>" class="tag-pill"><%= tag %></a>
          <% }) %>
        </div>
      <% } %>

      <div class="blog-body"><%= blog.body %></div>

      <% if (blog.createdBy) { %>
        <div class="author-card d-flex align-items-center gap-2 mb-4">
          <img src="<%= blog.createdBy.profileImageURL %>" width="42" height="42" class="rounded-circle" style="object-fit:cover;" />
          <span>Written by <strong><%= blog.createdBy.fullName %></strong></span>
        </div>
      <% } %>

      <hr class="my-4" />

      <h2 class="h4 mb-3">Comments (<%= comments ? comments.length : 0 %>)</h2>

      <% if (locals.user) { %>
        <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
          <div class="d-flex gap-2">
            <input type="text" name="content" class="form-control" placeholder="Add a comment…" required />
            <button class="btn btn-primary" type="submit">Post</button>
          </div>
        </form>
      <% } else { %>
        <p class="blog-meta mb-4"><a href="/user/signin">Sign in</a> to join the conversation.</p>
      <% } %>

      <div class="mb-5">
        <% if (comments && comments.length > 0) { %>
          <% comments.forEach(comment => { %>
            <div class="comment-card border p-3 mb-2">
              <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                <div class="d-flex align-items-center gap-2">
                  <img src="<%= comment.createdBy ? comment.createdBy.profileImageURL : '/images/default.png' %>" width="34" height="34" class="rounded-circle" style="object-fit:cover;" />
                  <strong><%= comment.createdBy ? comment.createdBy.fullName : 'Deleted user' %></strong>
                  <span class="blog-meta">&middot; <%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                </div>
                <% if (locals.user && (String(locals.user._id) === String(comment.createdBy && comment.createdBy._id) || locals.owner)) { %>
                  <button type="button" class="btn btn-sm btn-link text-danger p-0" data-confirm-delete
                    data-form-action="/blog/comment/delete/<%= comment._id %>"
                    data-confirm-text="Delete this comment?">
                    Delete
                  </button>
                <% } %>
              </div>
              <pre><%= comment.content %></pre>
            </div>
          <% }) %>
        <% } else { %>
          <p class="blog-meta">No comments yet — be the first to share your thoughts.</p>
        <% } %>
      </div>
    </div>

    <!-- Confirm delete modal -->
    <div class="confirm-overlay" id="confirmOverlay">
      <div class="confirm-dialog">
        <p id="confirmText" class="mb-4"></p>
        <div class="d-flex gap-2 justify-content-end">
          <button type="button" class="btn btn-outline-secondary" id="confirmCancel">Cancel</button>
          <form method="post" id="confirmForm">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
